{
  "name": "create-artubeplate",
  "version": "2.0.0",
  "description": "Scaffold an Artube RGS slot game on @artubeplate/core — `npm create artubeplate@latest`, optionally with your own math (`-- --math ./path`).",
  "keywords": [
    "artube",
    "rgs",
    "slot",
    "slots",
    "igaming",
    "scaffold",
    "create",
    "artubeplate",
    "pixijs"
  ],
  "license": "MIT",
  "author": "Dmitry Vasiliev",
  "homepage": "https://github.com/schmooky/artubeplate/tree/main/packages/create-artubeplate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmooky/artubeplate.git",
    "directory": "packages/create-artubeplate"
  },
  "bugs": {
    "url": "https://github.com/schmooky/artubeplate/issues"
  },
  "type": "module",
  "bin": {
    "create-artubeplate": "index.js"
  },
  "files": [
    "index.js",
    "template",
    "!template/node_modules",
    "!template/dist",
    "!template/.vite",
    "!template/test-results",
    "!template/.env",
    "!template/*.local",
    "!template/public/assets",
    "!template/.assetpack",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "prepublishOnly": "npm test"
  }
}
